FROM python:3.11-slim

WORKDIR /app

RUN pip install --no-cache-dir \
    "fastapi==0.111.0" \
    "uvicorn==0.30.1" \
    "onnxruntime==1.18.0" \
    "tokenizers==0.19.1" \
    "numpy==1.26.4"

COPY embedding/embedding_server.py .

EXPOSE 8000

CMD ["uvicorn", "embedding_server:app", "--host", "0.0.0.0", "--port", "8000"]
